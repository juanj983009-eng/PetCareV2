# Copia este archivo a .env.demo y sustituye solo los valores secretos localmente.
POSTGRES_DB=petcare_demo
POSTGRES_USER=petcare_demo
POSTGRES_PASSWORD=replace-with-a-local-demo-password
BACKEND_PORT=18080
FRONTEND_PORT=18081
PETCARE_JWT_SECRET=replace-with-a-local-demo-secret-of-at-least-32-bytes
PETCARE_JWT_ISSUER=https://petcare.demo.local
PETCARE_JWT_ACCESS_TOKEN_TTL=PT15M
PETCARE_BOOTSTRAP_ENABLED=true
PETCARE_BOOTSTRAP_TENANT_NAME=Clinica Veterinaria Demostracion
PETCARE_BOOTSTRAP_TENANT_SLUG=clinica-demo
PETCARE_BOOTSTRAP_TENANT_PLAN=STARTER
PETCARE_BOOTSTRAP_BRANCH_NAME=Sede Principal
PETCARE_BOOTSTRAP_BRANCH_TIME_ZONE=America/Lima
PETCARE_BOOTSTRAP_ADMIN_FIRST_NAME=Ana
PETCARE_BOOTSTRAP_ADMIN_LAST_NAME=Ficticia
PETCARE_BOOTSTRAP_ADMIN_EMAIL=ana.ficticia@demo.test
PETCARE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-demo-admin-password
